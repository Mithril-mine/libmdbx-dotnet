<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    <AssemblyName>mdbx-dotnet</AssemblyName>
		<Authors>Jerry.Wang, Anton May</Authors>
		<PackageProjectUrl>https://public.amsoft.spb.ru/libmdbx</PackageProjectUrl>
		<PackageId>mdbx</PackageId>
		<Description>.NET bindings of libmdbx - Fastfull embedded transactional key-value storage engine. Surpasses the legendary LMDB in reliability, capabilities and performance.  Used in hundreds of open source projects, including Ethereum.</Description>
		<PackageTags>lmdb mdbx libmdbx key-value performance storage-engine no-sql</PackageTags>
		<Version>0.14.3-39-8-develop</Version>
		<PublishAot>true</PublishAot>
		<AssemblyTitle>mdbx-dotnet</AssemblyTitle>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<ErrorReport>none</ErrorReport>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
		<CheckForOverflowUnderflow>True</CheckForOverflowUnderflow>
		<SignAssembly>False</SignAssembly>
		<Title>libmdbx-dotnet</Title>
		<Copyright>Jerry.Wang, Anton May</Copyright>
		<RepositoryUrl>https://public.git.amsoft.spb.ru/libmdbx/libmdbx-dotnet</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<Optimize>False</Optimize>
		<IsTrimmable>True</IsTrimmable>
		<IsAotCompatible>True</IsAotCompatible>
		<WarningLevel>9999</WarningLevel>
		<TreatWarningsAsErrors>True</TreatWarningsAsErrors>
		<CheckForOverflowUnderflow>True</CheckForOverflowUnderflow>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<IsTrimmable>True</IsTrimmable>
		<IsAotCompatible>True</IsAotCompatible>
		<WarningLevel>9999</WarningLevel>
		<TreatWarningsAsErrors>True</TreatWarningsAsErrors>
		<CheckForOverflowUnderflow>True</CheckForOverflowUnderflow>
		<Optimize>False</Optimize>
	</PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="" />
    <None Include="native\windows\x64\mdbx.dll" Pack="true" PackagePath="runtimes\win-x64\native" />
    <None Include="native\linux\x64\libmdbx.so" Pack="true" PackagePath="runtimes\linux-x64\native" />
  </ItemGroup>

  <ItemGroup>
    <NativeLibrary Include="native\windows\x64\mdbx.dll" Condition="'$(RuntimeIdentifier)' == 'win-x64'" />
    <NativeLibrary Include="native\linux\x64\libmdbx.so" Condition="'$(RuntimeIdentifier)' == 'linux-x64'" />
  </ItemGroup>

</Project>