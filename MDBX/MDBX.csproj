<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
	    <TargetFramework>net10.0</TargetFramework>
      <RuntimeIdentifier>win-x64</RuntimeIdentifier>
      <AssemblyName>mdbx-dotnet</AssemblyName>
      <Authors>Jerry.Wang, Anton May</Authors>
      <PackageProjectUrl>https://public.amsoft.spb.ru/libmdbx</PackageProjectUrl>
      <PackageId>mdbx</PackageId>
      <Description>.NET bindings of libmdbx - Fastfull embedded transactional key-value storage engine. Surpasses the legendary LMDB in reliability, capabilities and performance.  Used in hundreds of open source projects, including Ethereum.</Description>
      <PackageTags>lmdb mdbx libmdbx key-value performance storage-engine no-sql</PackageTags>
      <Version>0.13.11.30-1</Version>
      <PublishAot>true</PublishAot>
      <AssemblyTitle>mdbx-dotnet</AssemblyTitle>
      <ImplicitUsings>enable</ImplicitUsings>
      <Nullable>enable</Nullable>
      <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
      <GenerateDocumentationFile>True</GenerateDocumentationFile>
      <ErrorReport>none</ErrorReport>
      <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
      <CheckForOverflowUnderflow>True</CheckForOverflowUnderflow>
      <SignAssembly>False</SignAssembly>
      <Title>libmdbx-dotnet</Title>
      <Copyright>Jerry.Wang, Anton May</Copyright>
      <RepositoryUrl>https://public.git.amsoft.spb.ru/libmdbx/libmdbx-dotnet</RepositoryUrl>
      <RepositoryType>git</RepositoryType>
      <EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
      <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
      <Optimize>True</Optimize>
      <IsTrimmable>True</IsTrimmable>
      <IsAotCompatible>True</IsAotCompatible>
      <WarningLevel>9999</WarningLevel>
      <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
      <CheckForOverflowUnderflow>True</CheckForOverflowUnderflow>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
      <IsTrimmable>True</IsTrimmable>
      <IsAotCompatible>True</IsAotCompatible>
      <WarningLevel>9999</WarningLevel>
      <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
      <CheckForOverflowUnderflow>True</CheckForOverflowUnderflow>
    </PropertyGroup>

    <ItemGroup>
      <None Include="..\README.md" Pack="true" PackagePath="\"/>
      <None Update="native\windows\x64\*.dll" Pack="true" PackagePath="lib\net10.0\native\windows\x64">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="native\windows\x86\*.dll" Pack="true" PackagePath="lib\net10.0\native\windows\x86">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="native\linux\x64\*.so" Pack="true" PackagePath="lib\net10.0\native\linux\x64">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

</Project>