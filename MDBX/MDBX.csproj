<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
     <AssemblyName>mdbx-dotnet</AssemblyName>
     <Authors>Jerry.Wang, Anton May</Authors>
     <PackageProjectUrl>https://public.git.amsoft.spb.ru/libmdbx/libmdbx-dotnet</PackageProjectUrl>
     <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
     <PackageId>mdbx</PackageId>
     <Description>.NET bindings of libmdbx, succeeder of LMDB(Lightning Memory-Mapped Database)</Description>
     <PackageTags>lmdb mdbx libmdbx key-value performance storage-engine no-sql</PackageTags>
     <Version>0.13.11.30</Version>
     <PublishAot>true</PublishAot>
     <AssemblyTitle>mdbx-dotnet</AssemblyTitle>
     <ImplicitUsings>enable</ImplicitUsings>
     <Nullable>disable</Nullable>
     <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
     <GenerateDocumentationFile>false</GenerateDocumentationFile>
     <ErrorReport>none</ErrorReport>
     <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
     <CheckForOverflowUnderflow>True</CheckForOverflowUnderflow>
   </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <Optimize>True</Optimize>
    <IsTrimmable>True</IsTrimmable>
    <IsAotCompatible>True</IsAotCompatible>
    <WarningLevel>9999</WarningLevel>
    <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
    <CheckForOverflowUnderflow>True</CheckForOverflowUnderflow>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <IsTrimmable>True</IsTrimmable>
    <IsAotCompatible>True</IsAotCompatible>
    <WarningLevel>9999</WarningLevel>
    <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
    <CheckForOverflowUnderflow>True</CheckForOverflowUnderflow>
  </PropertyGroup>

  <ItemGroup>
    <None Update="native\linux\x64\libmdbx.so">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="native\windows\x64\mdbx.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

