{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../.",
          "files": [
            "MDBX/MDBX.csproj"
          ]
        }
      ],
      "dest": "api",
      "exclude": [
        "**/MDBX.UnitTest/**/*.{cs,yml}"
      ]
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "libmdbx-dotnet",
      "_appTitle": "Binding Documentation",
      "_enableSearch": true,
      "_appFaviconPath": "images/favicon.ico",
      "_appLogoPath": "images/logo.png",
      "pdf": true
    }
  }
}